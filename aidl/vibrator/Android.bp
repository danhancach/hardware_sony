package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "SonyVibratorDefaults",
    relative_install_path: "hw",
    static_libs: [
        "SonyVibratorCommon",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
    ],
    cflags: select(soong_config_variable("SonyVibratorVars", "use_compound_double_click_effect"), {
        true: ["-DUSE_COMPOUND_DOUBLE_CLICK_EFFECT"],
        default: ["-DUSE_EFFECT_DURATION_POLLING"],
    }),
}

cc_defaults {
    name: "SonyVibratorBinaryDefaults",
    defaults: ["SonyVibratorDefaults"],
    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
    ],
}

cc_defaults {
    name: "SonyVibratorTestDefaults",
    defaults: ["SonyVibratorDefaults"],
    static_libs: [
        "android.hardware.vibrator-V2-ndk",
    ],
    test_suites: ["device-tests"],
    require_root: true,
}
