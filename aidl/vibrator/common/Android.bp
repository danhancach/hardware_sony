package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library {
    name: "SonyVibratorCommon",
    srcs: [
        "HardwareBase.cpp",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-DATRACE_TAG=(ATRACE_TAG_VIBRATOR | ATRACE_TAG_HAL)",
        "-DLOG_TAG=\"android.hardware.vibrator@1.x-common\"",
    ],
    export_include_dirs: ["."],
    vendor_available: true,
}
