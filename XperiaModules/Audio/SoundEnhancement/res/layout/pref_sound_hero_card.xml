<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.SoundEnhancement.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- The Hero 1: Che do am thanh tong the (De xuat / Tuy chinh) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hero_mode_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sound_preference_card_margin_horizontal"
        android:layout_marginEnd="@dimen/sound_preference_card_margin_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="@dimen/sound_preference_corner_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/sound_card_background"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/img_mode_illustration"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/effect_recommendation" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_mode_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sound_enhance_mode_recommended_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_mode_status"
                    style="@style/Widget.SoundEnhancement.ActiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_enhance_active_badge" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_current_mode_summary"
                style="@style/TextAppearance.SoundEnhancement.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sound_enhance_mode_recommended_desc" />

            <!-- Rut gon chi con 2 tuy chon duy nhat: De xuat & Tuy chinh -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_recommended"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/sound_enhance_mode_recommended" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_custom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_enhance_mode_custom" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
