<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sonyericsson.soundenhancement"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SEARCH_INDEXABLES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="com.dolby.permission.DAXSERVICE" />
    <uses-permission android:name="jp.co.sony.threesixtyra.system.permission.ACCESS" />

    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@drawable/sound_enhance_application_icn"
        android:label="@string/sound_enhance_strings_app_name_txt"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.Expressive.SoundEnhancement">

        <!-- Man hinh cai dat am thanh Material 3 Expressive chinh -->
        <activity
            android:name=".ui.SoundSettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="@string/sound_enhance_strings_audio_settings_txt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Tich hop vao Android Settings (Sound & Vibration) -->
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="audiosettings" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_audio_settings_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_audio_settings_description_txt" />
        </activity>

        <!-- Man hinh quan ly ung dung uu tien hieu ung am thanh -->
        <activity
            android:name=".ui.EffectPriorityActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="@string/audio_settings_white_list_title_txt" />

        <!-- Activity Aliases tuong thich 100% voi loi goi cu tu he thong va ung dung Sony -->
        <activity-alias
            android:name="com.sonyericsson.soundenhancement.AudioEffectMenuActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="audiosettings" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_audio_settings_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_audio_settings_description_txt" />
        </activity-alias>

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.SoundEnhancementRedirector"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.AudioEffectMenuForAudioActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="audiosettings" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_audio_settings_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_audio_settings_description_txt" />
        </activity-alias>

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.AudioEffectMenuForDolbyAudioActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="dolbyaudiosettings" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_audio_settings_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_audio_settings_description_txt" />
        </activity-alias>

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.PlaybackEffectPresetMenuForDolbyAudioActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="audio_playback_setting" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_playback_quality_settings_title_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_playback_quality_settings_summary_txt" />
        </activity-alias>

        <!-- Stock: chi MAIN/MONKEY, khong inject Settings tile (thieu meta -> TileUtils NPE) -->
        <activity-alias
            android:name="com.sonyericsson.soundenhancement.PlaybackEffectPresetMenuActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Stock: khong co MANUFACTURER_APPLICATION_SETTING - chi alias deep-link -->
        <activity-alias
            android:name="com.sonyericsson.soundenhancement.PlaybackEffectPresetMenuForAudioActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity" />

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.RecordingEffectActivity"
            android:exported="true"
            android:targetActivity=".ui.SoundSettingsActivity">
            <intent-filter>
                <action android:name="com.android.settings.MANUFACTURER_APPLICATION_SETTING" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="audio_recording_setting" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="sound_quality_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sound_enhance_strings_recording_quality_settings_title_txt" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sound_enhance_strings_recording_quality_settings_summary_txt" />
        </activity-alias>

        <activity-alias
            android:name="com.sonyericsson.soundenhancement.EffectPriority.TargetAppListActivity"
            android:exported="true"
            android:targetActivity=".ui.EffectPriorityActivity" />

        <!-- Provider tim kiem cai dat he thong -->
        <provider
            android:name=".provider.SoundEnhancementSearchIndexablesProvider"
            android:authorities="com.sonyericsson.soundenhancement"
            android:exported="true"
            android:grantUriPermissions="true"
            android:multiprocess="false"
            android:permission="android.permission.READ_SEARCH_INDEXABLES">
            <intent-filter>
                <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER" />
            </intent-filter>
        </provider>

    </application>
</manifest>
