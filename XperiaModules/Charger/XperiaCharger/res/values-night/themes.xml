<resources>
    <style name="Theme.BatteryMonitor" parent="@style/Theme.SubSettingsBase.Expressive">
        <item name="android:popupMenuStyle">@style/BatteryMonitorPopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/BatteryMonitorPopupMenuOverflow</item>
        <item name="android:popupTheme">@style/BatteryMonitorPopupOverlay</item>
        <item name="android:colorBackground">@android:color/system_surface_container_dark</item>
        <item name="android:windowBackground">@android:color/system_surface_container_dark</item>
    </style>

    <style name="BatteryMonitorPopupOverlay" parent="@android:style/ThemeOverlay.Material.Dark">
        <item name="android:popupMenuStyle">@style/BatteryMonitorPopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/BatteryMonitorPopupMenuOverflow</item>
        <item name="android:colorBackground">@color/battery_monitor_popup_surface</item>
        <item name="android:textColorPrimary">@android:color/system_on_surface_dark</item>
        <item name="android:textColorSecondary">@android:color/system_on_surface_variant_dark</item>
    </style>
</resources>
