<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/viewpager_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/creator_mode_card_margin_horizontal"
        android:layout_marginEnd="@dimen/creator_mode_card_margin_horizontal"
        app:cardCornerRadius="@dimen/creator_mode_card_corner_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright">

        <!-- Bao ve cu chi vuot ngang ViewPager2 o che do man hinh ngang -->
        <com.xperia.settings.ui.XperiaNestedHorizontalAxisGuard
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.xperia.settings.ui.XperiaNestedHorizontalAxisGuard>
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/creator_mode_preview_nav_height">

        <FrameLayout
            android:id="@+id/arrow_previous"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/creator_mode_previous"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_left" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/viewGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/arrow_next"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/creator_mode_next"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
