<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Card bo 20dp SurfaceBright boc ViewPager2 preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/viewpager_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/creator_mode_card_margin_horizontal"
        android:layout_marginEnd="@dimen/creator_mode_card_margin_horizontal"
        app:cardCornerRadius="@dimen/creator_mode_card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceBright">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creator_mode_preview_height" />

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/creator_mode_preview_nav_height">

        <FrameLayout
            android:id="@+id/arrow_previous"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/creator_mode_previous"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_left" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/viewGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/arrow_next"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creator_mode_preview_nav_height"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/creator_mode_next"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
